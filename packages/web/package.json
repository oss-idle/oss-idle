{
  "name": "@oss-idle/web",
  "private": true,
  "version": "1.3.0.0",
  "type": "module",
  "description": "osu!web-style site served at /web, browsable in-game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e:serve": "NODE_ENV=development vite build --mode development --outDir dist.e2e --emptyOutDir && vite preview --mode development --outDir dist.e2e --strictPort",
    "extract": "lingui extract --clean",
    "compile": "lingui compile"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@lingui/react": "^5.9.5",
    "@oss-idle/server": "*",
    "@oss-idle/shared": "*",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/zod-adapter": "^1.167.0",
    "d3-shape": "^3.2.0",
    "hono": "^4.6.14",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/d3-shape": "^3.1.8",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
