{
  "name": "@oss-idle/desktop",
  "version": "1.3.0.0",
  "author": {
    "name": "Adrien Boitelle",
    "email": "adrien.boitelle@gmail.com",
    "url": "https://oss.idle.rhythmgamers.net/"
  },
  "private": true,
  "description": "oss!idle",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "docker run --rm -t -v \"$(realpath ../..)\":/project -w /project/packages/desktop --user $(id -u):$(id -g) -e XDG_CACHE_HOME=/project/.cache -e npm_config_cache=/project/.npm-cache -e HOME=/project/.cache -e RENDERER_DIST electronuserland/builder:wine node build.js",
    "dist:linuxwin": "electron-builder --linux --win"
  },
  "dependencies": {
    "@oss-idle/shared": "*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "44.9.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}