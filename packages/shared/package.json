{
  "name": "@oss-idle/shared",
  "version": "1.3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./shared.css": "./src/shared.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "lingui compile --typescript && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepare": "npm run build",
    "extract": "lingui extract --clean",
    "compile": "lingui compile --typescript"
  },
  "dependencies": {
    "@lingui/core": "^5.9.5",
    "acorn": "^8.19.0",
    "discord-api-types": "^0.38.49",
    "osu-classes": "^3.1.0",
    "osu-mania-stable": "^5.0.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/cli": "^5.9.5",
    "@lingui/conf": "^5.9.5",
    "@types/prismjs": "^1.26.6",
    "typescript": "^5.6.3"
  }
}
