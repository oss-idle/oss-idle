# development | production. Drives the derived osu! redirect URI and Secure cookie.
NODE_ENV=development

# HTTP - dev and prod use separate ports so a running prod (systemd) service and
# a local `npm run dev` never collide. The server picks PORT when NODE_ENV is not
# production, and PORT_PROD when it is (the Apache vhost proxies to PORT_PROD).
PORT=3873
PORT_PROD=3875

# CORS / redirect target - the client app origin. Per-env (shared .env), so the
# server trusts CLIENT_URL when NODE_ENV is not production and CLIENT_URL_PROD when
# it is. Keeps prod from trusting the dev (localhost) origin.
CLIENT_URL=http://localhost:5173
CLIENT_URL_PROD=https://oss.idle.rhythmgamers.net
# Where browsers reach the API in production, and its session cookie, for your own domain.
# API_URL_PROD=https://api.oss.idle.rhythmgamers.net
# SESSION_COOKIE_NAME=session
# SESSION_COOKIE_DOMAIN=oss.idle.rhythmgamers.net
# Dev only: where browsers reach this API when it isn't localhost (a LAN staging).
# API_URL=http://oss.idle.lan:5173

# MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oss_idle
DB_PASSWORD=change_me
DB_NAME=oss_idle
# The database `npm run dev` uses (NODE_ENV not production).
DB_NAME_DEV=oss_idle_dev
# The farm's stats database (read-only, same credentials): mirrors every
# ranked/loved beatmap and backs the map-request search box.
STATS_DB_NAME=stats
# Its host, when it is not DB_HOST.
# STATS_DB_HOST=stats.example

# osu! OAuth application (https://osu.ppy.sh/home/account/edit → OAuth).
# The callback URIs are derived from NODE_ENV (dev: http://localhost:PORT/...,
# prod: https://api.oss.idle.rhythmgamers.net/...) - register both on the app.
OSU_CLIENT_ID=change_me
OSU_CLIENT_SECRET=change_me

# osu! API scheduler (https://github.com/Adrriii/osu-api-scheduler): every osu!
# API call goes through it, so the host's per-IP rate budget is shared.
OSU_API_URL=https://osu.api.rhythmgamers.net
# Where scores read from osu! are also sent, when set.
# SCORE_CACHE_URL=
# SCORE_CACHE_SECRET=
OSU_SCHEDULER_TOKEN=change_me

# Where a requested map's .osz is pulled from when ingesting it from the queue.
BEATMAP_MIRROR_URL=https://catboy.best/d/{setId}

# Secret for signing session + CSRF-state JWTs (use a long random string).
JWT_SECRET=change_me

# Stripe, for supporter tags (sk_test_... on dev). The webhook secret is the
# dashboard endpoint's on prod; on dev, `stripe listen --print-secret`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Abby (Intégrations → clé API): prod books each supporter order in the livre des recettes
# 14 days after payment, net of Stripe fees and refunds.
ABBY_API_KEY=

# itch.io: an API key of the oss!idle page's owner, to read its purchases. Without it,
# players can't claim itch.io donations as supporter. ITCH_CLIENT_ID defaults to the
# oss!idle OAuth app, whose callback is prod's.
ITCH_API_KEY=

# The oss.idle@boitech.dev mailbox, which sends supporter thank-you emails (none without it):
# smtps://oss.idle%40boitech.dev:password@mail.boitech.dev:465
SMTP_URL=

# The thank-you email says how long a donation keeps the server running
SERVER_MONTHLY_COST=50
SUPPORTER_TAXES=20,30

# Redis: plays, presence, matches, rankings, rate limits.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Discord webhooks for the map, news, new-player and error feeds. Empty = not posted.
MAP_FEED_WEBHOOK=
# Role ids the map feed pings for ranked / loved maps (members pick them in Channels & Roles).
# Empty = no ping.
MAP_FEED_ROLE_ID=
MAP_FEED_LOVED_ROLE_ID=
NEWS_FEED_WEBHOOK=
USER_FEED_WEBHOOK=
ERROR_FEED_WEBHOOK=
BUG_FEED_WEBHOOK=

# Discord account linking (level roles). Empty secret = linking off.
DISCORD_CLIENT_SECRET=

# A GeoLite2 / DB-IP City .mmdb for the world map. Empty = country-level only.
GEOIP_DB=
