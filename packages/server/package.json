{
  "name": "@oss-idle/server",
  "version": "1.3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "NODE_ENV=production tsx src/index.ts",
    "addon-builder": "tsx src/addonBuilder.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "NODE_ENV=production drizzle-kit migrate",
    "push": "drizzle-kit push",
    "push:prod": "NODE_ENV=production drizzle-kit push",
    "studio": "drizzle-kit studio",
    "studio:prod": "NODE_ENV=production drizzle-kit studio",
    "migrate:beatmaps": "tsx src/db/migrate-beatmaps.ts",
    "migrate:beatmaps:prod": "NODE_ENV=production tsx src/db/migrate-beatmaps.ts",
    "reingest:beatmaps": "tsx src/db/reingest-beatmaps.ts",
    "reingest:beatmaps:prod": "NODE_ENV=production tsx src/db/reingest-beatmaps.ts",
    "import:maps": "tsx src/db/import-maps.ts",
    "import:maps:prod": "NODE_ENV=production tsx src/db/import-maps.ts",
    "credit:mappers": "tsx src/db/credit-mappers.ts",
    "credit:mappers:prod": "NODE_ENV=production tsx src/db/credit-mappers.ts",
    "bake:covers": "tsx src/db/bake-covers.ts",
    "bake:covers:prod": "NODE_ENV=production tsx src/db/bake-covers.ts",
    "webhook:preview": "tsx src/db/webhookPreview.ts",
    "news:preview": "tsx src/news/preview.ts",
    "news:preview:prod": "NODE_ENV=production tsx src/news/preview.ts",
    "bugs": "tsx src/bugsCli.ts",
    "bugs:prod": "NODE_ENV=production tsx src/bugsCli.ts",
    "extract": "lingui extract --clean",
    "replay:scores": "tsx src/db/replay-scores.ts",
    "replay:scores:prod": "NODE_ENV=production tsx src/db/replay-scores.ts",
    "fix:overall": "tsx src/db/fix-overall-levels.ts",
    "fix:overall:prod": "NODE_ENV=production tsx src/db/fix-overall-levels.ts",
    "relevel": "tsx src/db/relevel-characters.ts",
    "relevel:prod": "NODE_ENV=production tsx src/db/relevel-characters.ts",
    "fix:ln": "tsx src/db/fix-ln-counts.ts",
    "fix:ln:prod": "NODE_ENV=production tsx src/db/fix-ln-counts.ts",
    "purge:intro": "tsx src/db/purge-intro-scores.ts",
    "purge:intro:prod": "NODE_ENV=production tsx src/db/purge-intro-scores.ts",
    "fix:totals": "tsx src/db/fix-totals.ts",
    "fix:totals:prod": "NODE_ENV=production tsx src/db/fix-totals.ts",
    "revoke:medals": "tsx src/db/revoke-unranked-medals.ts",
    "revoke:medals:prod": "NODE_ENV=production tsx src/db/revoke-unranked-medals.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.8.0",
    "@lingui/core": "^5.9.5",
    "@oss-idle/shared": "*",
    "@resvg/resvg-js": "^2.6.2",
    "adm-zip": "^0.5.16",
    "discord-api-types": "^0.38.49",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "ioredis": "^5.11.1",
    "maxmind": "^5.0.6",
    "mysql2": "^3.12.0",
    "nodemailer": "^8.0.11",
    "osu-classes": "^3.1.0",
    "osu-mania-stable": "^5.0.1",
    "osu-parsers": "^4.1.7",
    "rosu-pp-js": "^4.0.1",
    "stripe": "^23.0.0",
    "tsx": "^4.19.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.3"
  }
}
